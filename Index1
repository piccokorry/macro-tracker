// BARCODE SCANNER
let barcodeRunning=false;

function openBarcode(mealId){
  window._barcodeMealId=mealId;
  openModal(`<div class="modal">
    <div class="modal-header">
      <div class="modal-title">Scan Barcode</div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body">
      <div class="camera-area">
        <video id="barcode-video" autoplay muted playsinline></video>
        <div class="scan-corners">
          <div class="corner tl"></div><div class="corner tr"></div>
          <div class="corner bl"></div><div class="corner br"></div>
        </div>
        <div class="scan-line"></div>
        <div class="scan-status" id="scan-status">Point camera at barcode</div>
      </div>
      <div id="barcode-result"></div>
    </div>
  </div>`);
  startBarcode(mealId);
}

function startBarcode(mealId){
  if(!navigator.mediaDevices){
    document.getElementById("scan-status").textContent="Camera not available";
    return;
  }
  barcodeRunning=true;
  navigator.mediaDevices.getUserMedia({video:{facingMode:"environment"}}).then(stream=>{
    const video=document.getElementById("barcode-video");
    if(!video){stream.getTracks().forEach(t=>t.stop());return;}
    video.srcObject=stream;
    window._barcodeStream=stream;
    Quagga.init({
      inputStream:{type:"LiveStream",target:video,constraints:{facingMode:"environment"}},
      decoder:{readers:["ean_reader","upc_reader","ean_8_reader","code_128_reader"]}
    },err=>{
      if(err){document.getElementById("scan-status").textContent="Camera error — try Manual Entry";return;}
      Quagga.start();
      Quagga.onDetected(result=>{
        const code=result.codeResult.code;
        stopBarcode();
        fetchBarcode(code,mealId);
      });
    });
  }).catch(()=>{
    const el=document.getElementById("scan-status");
    if(el) el.textContent="Camera permission denied";
  });
}

function stopBarcode(){
  barcodeRunning=false;
  try{Quagga.stop();}catch(e){}
  if(window._barcodeStream){
    window._barcodeStream.getTracks().forEach(t=>t.stop());
    window._barcodeStream=null;
  }
}

async function fetchBarcode(code,mealId){
  const el=document.getElementById("scan-status")||document.getElementById("barcode-result");
  openModal(`<div class="modal">
    <div class="modal-header">
      <div class="modal-title">Looking up ${code}...</div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body" style="text-align:center;padding:40px">
      <div class="spinner"></div>
      <div style="color:var(--muted);margin-top:16px;font-size:14px">Fetching nutrition data...</div>
    </div>
  </div>`);

  try{
    const r=await fetch(`https://world.openfoodfacts.org/api/v0/product/${code}.json`);
    const data=await r.json();
    if(data.status!==1||!data.product){
      openModal(`<div class="modal">
        <div class="modal-header">
          <div class="modal-title">Product Not Found</div>
          <button class="modal-close" onclick="closeModal()">✕</button>
        </div>
        <div class="modal-body">
          <div style="color:var(--muted);font-size:14px;margin-bottom:20px">Barcode ${code} not found in database. Enter details manually.</div>
        </div>
        <div class="modal-footer">
          <button class="confirm-btn" onclick="openManual('${mealId}')">Manual Entry</button>
        </div>
      </div>`);
      return;
    }
    const prod=data.product;
    const n=prod.nutriments||{};
    const name=prod.product_name||prod.product_name_en||"Scanned Product";
    const cal=Math.round(n["energy-kcal_100g"]||n["energy-kcal"]||0);
    const p=Math.round(n.proteins_100g||0);
    const c=Math.round(n.carbohydrates_100g||0);
    const f=Math.round(n.fat_100g||0);
    const ingr=(prod.ingredients_text||"").toLowerCase();
    const allergens=(prod.allergens||"").toLowerCase();
    const glutenFlag=GLUTEN_KEYWORDS.some(k=>ingr.includes(k)||allergens.includes(k)||name.toLowerCase().includes(k));
    const food={name,cal,p,c,f,per:100,unit:"g",gluten:glutenFlag,cat:"Scanned"};
    window._searchMatches=[food];
    openFoodDetail(0,mealId,true,food);
  }catch(e){
    openModal(`<div class="modal">
      <div class="modal-header">
        <div class="modal-title">Network Error</div>
        <button class="modal-close" onclick="closeModal()">✕</button>
      </div>
      <div class="modal-body">
        <div style="color:var(--muted);font-size:14px;margin-bottom:20px">Could not fetch product data. Check your connection or use Manual Entry.</div>
      </div>
      <div class="modal-footer">
        <button class="confirm-btn" onclick="openManual('${mealId}')">Manual Entry</button>
      </div>
    </div>`);
  }
}

// WEEK SHARE MODAL
function openWeekShare(){
  const days=Array.from({length:7},(_,i)=>{
    const d=new Date(); d.setDate(d.getDate()-(6-i));
    return d.toISOString().split("T")[0];
  });
  const dayLabels=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
  let text=`WEEKLY RECAP — ${days[0]} to ${days[6]}\n`;
  text+=`${"\u2500".repeat(46)}\n`;
  text+=`DAY          KCAL    PRO    CARB   FAT\n`;
  text+=`${"\u2500".repeat(46)}\n`;

  const tracked=[];
  days.forEach(date=>{
    const entries=allEntries(date);
    const lbl=dayLabels[new Date(date+"T12:00:00").getDay()]+" "+date.slice(5);
    if(!entries.length){
      text+=`${lbl.padEnd(12)} ${"\u2014".padStart(5)}   ${"\u2014".padStart(4)}   ${"\u2014".padStart(4)}   ${"\u2014".padStart(3)}\n`;
      return;
    }
    const m=getMacros(entries);
    tracked.push(m);
    text+=`${lbl.padEnd(12)} ${String(fmt(m.calories)).padStart(5)}   ${(fmt(m.protein)+"g").padStart(4)}   ${(fmt(m.carbs)+"g").padStart(4)}   ${(fmt(m.fat)+"g").padStart(3)}\n`;
  });

  text+=`${"\u2500".repeat(46)}\n`;
  if(tracked.length){
    const avg={calories:0,protein:0,carbs:0,fat:0};
    tracked.forEach(m=>Object.keys(avg).forEach(k=>avg[k]+=m[k]));
    Object.keys(avg).forEach(k=>avg[k]=avg[k]/tracked.length);
    text+=`AVG/DAY      ${String(fmt(avg.calories)).padStart(5)}   ${(fmt(avg.protein)+"g").padStart(4)}   ${(fmt(avg.carbs)+"g").padStart(4)}   ${(fmt(avg.fat)+"g").padStart(3)}\n`;
    text+=`TARGET       ${String(goals.calories).padStart(5)}   ${(goals.protein+"g").padStart(4)}   ${(goals.carbs+"g").padStart(4)}   ${(goals.fat+"g").padStart(3)}\n`;
    text+=`${"\u2500".repeat(46)}\n`;
    const dc=fmt(avg.calories)-goals.calories, dp=fmt(avg.protein)-goals.protein;
    const dcb=fmt(avg.carbs)-goals.carbs, df=fmt(avg.fat)-goals.fat;
    const sgn=n=>(n>=0?"+":"")+n;
    text+=`VARIANCE     ${sgn(dc).padStart(5)}   ${(sgn(dp)+"g").padStart(4)}   ${(sgn(dcb)+"g").padStart(4)}   ${(sgn(df)+"g").padStart(3)}\n`;
    text+=`${"\u2500".repeat(46)}\n`;
    text+=`Days logged: ${tracked.length}/7\n`;
  } else {
    text+=`No days logged this week.\n`;
  }

  openModal(`<div class="modal">
    <div class="modal-header">
      <div class="modal-title">Weekly Recap</div>
      <button class="modal-close" onclick="closeModal()">\u2715</button>
    </div>
    <div class="modal-body">
      <div class="share-text" id="share-text">${text}</div>
    </div>
    <div class="modal-footer">
      <button class="copy-btn" onclick="copyShare()">Copy to Clipboard</button>
    </div>
  </div>`);
  window._shareText=text;
}

// SHARE MODAL
function openShare(){
  const d=getDayLog(currentDate);
  const entries=allEntries(currentDate);
  const totals=getMacros(entries);
  const dateLabel=currentDate===todayStr()?"Today":currentDate;
  let text=`MACRO LOG — ${dateLabel}\n`;
  text+=`${"─".repeat(30)}\n`;
  text+=`Calories: ${fmt(totals.calories)} / ${goals.calories} kcal\n`;
  text+=`Protein:  ${fmt(totals.protein)}g / ${goals.protein}g\n`;
  text+=`Carbs:    ${fmt(totals.carbs)}g / ${goals.carbs}g\n`;
  text+=`Fat:      ${fmt(totals.fat)}g / ${goals.fat}g\n`;
  text+=`Water:    ${((d.water||0)/1000).toFixed(1)}L / ${(goals.water/1000).toFixed(1)}L\n`;
  text+=`${"─".repeat(30)}\n`;
  SAVED_MEALS.forEach(meal=>{
    const mealEntries=d.meals?.[meal.id]||[];
    if(!mealEntries.length) return;
    const mm=getMacros(mealEntries);
    text+=`\n${meal.emoji} ${meal.name}\n`;
    mealEntries.forEach(e=>{
      const ratio=e.qty/(e.per||1);
      text+=`  • ${e.name} (${e.qty}${e.unit}) — P:${fmt(e.protein*ratio)}g C:${fmt(e.carbs*ratio)}g F:${fmt(e.fat*ratio)}g\n`;
    });
    text+=`  Total: ${fmt(mm.calories)} kcal | P:${fmt(mm.protein)}g C:${fmt(mm.carbs)}g F:${fmt(mm.fat)}g\n`;
  });

  openModal(`<div class="modal">
    <div class="modal-header">
      <div class="modal-title">Share Summary</div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body">
      <div style="color:var(--muted);font-size:13px;margin-bottom:12px">Copy and paste this into your chat with Claude.</div>
      <div class="share-text" id="share-text">${text}</div>
    </div>
    <div class="modal-footer">
      <button class="copy-btn" onclick="copyShare()">Copy to Clipboard</button>
    </div>
  </div>`);
  window._shareText=text;
}

function copyShare(){
  navigator.clipboard.writeText(window._shareText||"").then(()=>{
    const btn=document.querySelector(".copy-btn");
    if(btn){btn.textContent="✓ Copied!";setTimeout(()=>{btn.textContent="Copy to Clipboard";},2000);}
  }).catch(()=>{
    const el=document.getElementById("share-text");
    if(el){const r=document.createRange();r.selectNode(el);window.getSelection().removeAllRanges();window.getSelection().addRange(r);}
  });
}

