function isGluten(item){
  if(item.gluten) return true;
  const n=(item.name||"").toLowerCase();
  return GLUTEN_KEYWORDS.some(k=>n.includes(k));
}

// STATE
let goals = {...GOALS_DEFAULT};
let log = {};
let currentDate = todayStr();
let expandedMeals = {};
let currentView = "day";

function todayStr(){
  return new Date().toISOString().split("T")[0];
}

function loadData(){
  try{
    const g=localStorage.getItem("kp-goals");
    if(g) goals={...GOALS_DEFAULT,...JSON.parse(g)};
    const l=localStorage.getItem("kp-log");
    if(l) log=JSON.parse(l);
  }catch(e){}
}

function saveData(){
  try{
    localStorage.setItem("kp-goals",JSON.stringify(goals));
    localStorage.setItem("kp-log",JSON.stringify(log));
  }catch(e){}
}

function getDayLog(date){
  if(!log[date]) log[date]={meals:{},water:0};
  return log[date];
}

function getMacros(entries){
  const r={calories:0,protein:0,carbs:0,fat:0};
  (entries||[]).forEach(e=>{
    const ratio=e.qty/(e.per||1);
    r.calories+=(e.calories||0)*ratio;
    r.protein+=(e.protein||0)*ratio;
    r.carbs+=(e.carbs||0)*ratio;
    r.fat+=(e.fat||0)*ratio;
  });
  return r;
}

function fmt(n){return Math.round(n||0);}
function pct(v,g){return Math.min(100,Math.round((v/g)*100));}

function allEntries(date){
  const d=getDayLog(date);
  return Object.values(d.meals||{}).flat();
}

function renderAll(){
  if(currentView==="day") renderDay();
  else if(currentView==="week") renderWeek();
  else renderGoals();
}

// ── DAY VIEW ──────────────────────────────────────────────────────────────────
function renderDay(){
  const d=getDayLog(currentDate);
  const entries=allEntries(currentDate);
  const totals=getMacros(entries);
  const isToday=currentDate===todayStr();
  const displayDate=()=>{
    if(isToday) return "Today";
    const yd=new Date(); yd.setDate(yd.getDate()-1);
    if(currentDate===yd.toISOString().split("T")[0]) return "Yesterday";
    const dt=new Date(currentDate+"T12:00:00");
    return dt.toLocaleDateString("en-CA",{weekday:"short",month:"short",day:"numeric"});
  };

  const overProt=fmt(totals.protein)>goals.protein;
  const overCarb=fmt(totals.carbs)>goals.carbs;
  const overFat=fmt(totals.fat)>goals.fat;
  const overCal=fmt(totals.calories)>goals.calories;

  let html=`
  <div class="date-nav">
    <button onclick="navDate(-1)">‹</button>
    <div class="date-label">${displayDate()}</div>
    <button onclick="navDate(1)" ${isToday?"disabled":""}>›</button>
  </div>
  <div class="summary">
    <div class="cal-row">
      <div>
        <div class="cal-big" style="color:${overCal?"var(--red)":"var(--cal)"}">${fmt(totals.calories)}</div>
        <div class="cal-label">of ${goals.calories} kcal</div>
      </div>
      <div class="macro-pills">
        <div class="macro-pill">
          <div class="val" style="color:${overProt?"var(--red)":"var(--protein)"}">${fmt(totals.protein)}<span style="font-size:14px">g</span></div>
          <div class="lbl">Protein</div>
          <div class="rem" style="color:${overProt?"var(--red)":"var(--dim)"}">${overProt?"over":""+Math.max(0,goals.protein-fmt(totals.protein))+"g left"}</div>
        </div>
        <div class="macro-pill">
          <div class="val" style="color:${overCarb?"var(--red)":"var(--carbs)"}">${fmt(totals.carbs)}<span style="font-size:14px">g</span></div>
          <div class="lbl">Carbs</div>
          <div class="rem" style="color:${overCarb?"var(--red)":"var(--dim)"}">${overCarb?"over":""+Math.max(0,goals.carbs-fmt(totals.carbs))+"g left"}</div>
        </div>
        <div class="macro-pill">
          <div class="val" style="color:${overFat?"var(--red)":"var(--orange)"}">${fmt(totals.fat)}<span style="font-size:14px">g</span></div>
          <div class="lbl">Fat</div>
          <div class="rem" style="color:${overFat?"var(--red)":"var(--dim)"}">${overFat?"over":""+Math.max(0,goals.fat-fmt(totals.fat))+"g left"}</div>
        </div>
      </div>
    </div>
    ${barHTML("Calories",totals.calories,goals.calories,"var(--cal)"," kcal")}
    ${barHTML("Protein",totals.protein,goals.protein,"var(--protein)")}
    ${barHTML("Carbs",totals.carbs,goals.carbs,"var(--carbs)")}
    ${barHTML("Fat",totals.fat,goals.fat,"var(--orange)")}
  </div>
  ${waterHTML(d)}
  ${SAVED_MEALS.map(m=>mealCardHTML(m,d)).join("")}
  `;
  document.getElementById("view-day").innerHTML=html;
}

function barHTML(label,val,goal,color,unit="g"){
  const p=pct(val,goal);
  const over=fmt(val)>goal;
  return `<div class="bar-row">
    <div class="bar-label-row"><span>${label}</span><span style="color:${over?"var(--red)":"var(--muted)"}">${fmt(val)}/${goal}${unit}</span></div>
    <div class="bar-track"><div class="bar-fill" style="width:${p}%;background:${over?"var(--red)":color}"></div></div>
  </div>`;
}

function waterHTML(d){
  const w=d.water||0;
  const p=pct(w,goals.water);
  const over=w>=goals.water;
  return `<div class="water-card">
    <div class="water-header">
      <div class="water-title">💧 Water</div>
      <div class="water-val" style="color:${over?"var(--green)":"var(--teal)"}">${(w/1000).toFixed(1)}L / ${(goals.water/1000).toFixed(1)}L</div>
    </div>
    <div class="bar-track"><div class="bar-fill" style="width:${p}%;background:${over?"var(--green)":"var(--teal)"}"></div></div>
    <div class="water-btns">
      <button class="water-btn" onclick="addWater(250)">+250ml</button>
      <button class="water-btn" onclick="addWater(500)">+500ml</button>
      <button class="water-btn" onclick="addWater(750)">+750ml</button>
      <button class="water-btn" onclick="addWater(1000)">+1L</button>
      <button class="water-btn-minus" onclick="addWater(-250)">−</button>
    </div>
  </div>`;
}

function mealCardHTML(meal,d){
  const entries=d.meals?.[meal.id]||[];
  const macros=getMacros(entries);
  const exp=expandedMeals[meal.id]!==false;
  let entriesHTML="";
  entries.forEach((e,i)=>{
    const ratio=e.qty/(e.per||1);
    const ec=fmt((e.calories||0)*ratio);
    const ep=fmt((e.protein||0)*ratio);
    const ecarb=fmt((e.carbs||0)*ratio);
    const ef=fmt((e.fat||0)*ratio);
    const glutenFlag=isGluten(e)?`<span class="gluten-badge">GLUTEN</span>`:"";
    entriesHTML+=`<div class="entry-row">
      <div>
        <div class="entry-name">${e.name}${glutenFlag}</div>
        <div class="entry-qty">${e.qty}${e.unit}</div>
      </div>
      <div class="entry-macros">
        <span style="color:var(--cal)">${ec}</span>
        <span style="color:var(--protein)">${ep}g P</span>
        <span style="color:var(--carbs)">${ecarb}g C</span>
        <span style="color:var(--orange)">${ef}g F</span>
        <div class="entry-actions">
          <button class="entry-btn" onclick="editEntry('${meal.id}',${i})">✏️</button>
          <button class="entry-btn" onclick="removeEntry('${meal.id}',${i})">✕</button>
        </div>
      </div>
    </div>`;
  });

  const macroSummary=entries.length?`<div class="meal-macros">
    <span style="color:var(--cal)">${fmt(macros.calories)}</span>
    <span style="color:var(--protein)">${fmt(macros.protein)}g P</span>
    <span style="color:var(--carbs)">${fmt(macros.carbs)}g C</span>
    <span style="color:var(--orange)">${fmt(macros.fat)}g F</span>
  </div>`:"";

  return `<div class="meal-card">
    <div class="meal-header" onclick="toggleMeal('${meal.id}')">
      <div class="meal-left">
        <div class="meal-emoji">${meal.emoji}</div>
        <div>
          <div class="meal-name">${meal.name}</div>
          <div class="meal-time">${meal.time}</div>
        </div>
      </div>
      <div class="meal-right">${macroSummary}<span style="color:var(--muted);font-size:18px">${exp?"▲":"▼"}</span></div>
    </div>
    ${exp?`<div class="meal-body">
      ${entriesHTML}
      <div class="meal-actions">
        <button class="meal-action-btn" onclick="openSavedMeal('${meal.id}')">📋 Saved Items</button>
        <button class="meal-action-btn" onclick="openSearch('${meal.id}')">🔍 Search</button>
        <button class="meal-action-btn" onclick="openBarcode('${meal.id}')">📷 Scan</button>
        <button class="meal-action-btn" onclick="openManual('${meal.id}')">✏️ Manual</button>
      </div>
    </div>`:""}
  </div>`;
}

// ── WEEK VIEW ─────────────────────────────────────────────────────────────────
function renderWeek(){
  const days=Array.from({length:7},(_,i)=>{
    const d=new Date(); d.setDate(d.getDate()-(6-i));
    return d.toISOString().split("T")[0];
  });
  const dayLabels=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
  let barsHTML=days.map(date=>{
    const entries=allEntries(date);
    const macros=getMacros(entries);
    const p=pct(macros.calories,goals.calories);
    const isT=date===todayStr();
    const bg=p>100?"var(--red)":p>80?"var(--green)":"var(--blue)";
    const label=dayLabels[new Date(date+"T12:00:00").getDay()];
    return `<div class="week-day">
      <div class="week-label ${isT?"today":""}">${label}</div>
      <div class="week-bar-track"><div class="week-bar-fill" style="height:${p}%;background:${bg};min-height:${entries.length?4:0}px"></div></div>
      <div class="week-cal">${entries.length?fmt(macros.calories):"—"}</div>
    </div>`;
  }).join("");

  const tracked=days.filter(d=>allEntries(d).length>0);
  const avgs={calories:0,protein:0,carbs:0,fat:0};
  if(tracked.length){
    tracked.forEach(d=>{const m=getMacros(allEntries(d));Object.keys(avgs).forEach(k=>avgs[k]+=m[k]);});
    Object.keys(avgs).forEach(k=>avgs[k]=fmt(avgs[k]/tracked.length));
  }

  document.getElementById("view-week").innerHTML=`
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <div style="color:var(--muted);font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase">Last 7 Days</div>
      <button class="share-btn" onclick="openWeekShare()">Copy Week ↗</button>
    </div>
    <div class="week-bars">${barsHTML}</div>
    <div style="color:var(--muted);font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:12px">Daily Averages</div>
    <div class="avg-grid">
      <div class="avg-card"><div class="avg-val" style="color:var(--cal)">${avgs.calories}</div><div class="avg-lbl">kcal / day</div></div>
      <div class="avg-card"><div class="avg-val" style="color:var(--protein)">${avgs.protein}g</div><div class="avg-lbl">protein / day</div></div>
      <div class="avg-card"><div class="avg-val" style="color:var(--carbs)">${avgs.carbs}g</div><div class="avg-lbl">carbs / day</div></div>
      <div class="avg-card"><div class="avg-val" style="color:var(--orange)">${avgs.fat}g</div><div class="avg-lbl">fat / day</div></div>
    </div>`;
}

