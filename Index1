// ── ACTIONS ───────────────────────────────────────────────────────────────────
function setView(v,btn){
  currentView=v;
  document.querySelectorAll(".nav-btn").forEach(b=>b.classList.remove("active"));
  btn.classList.add("active");
  ["day","week","goals"].forEach(id=>{
    document.getElementById("view-"+id).style.display=id===v?"block":"none";
  });
  renderAll();
}

function navDate(dir){
  const d=new Date(currentDate+"T12:00:00");
  d.setDate(d.getDate()+dir);
  const nd=d.toISOString().split("T")[0];
  if(nd>todayStr()) return;
  currentDate=nd;
  renderDay();
}

function toggleMeal(id){
  expandedMeals[id]=expandedMeals[id]===false?true:false;
  renderDay();
}

function addWater(ml){
  const d=getDayLog(currentDate);
  d.water=Math.max(0,(d.water||0)+ml);
  saveData();
  renderDay();
}

function removeEntry(mealId,idx){
  const d=getDayLog(currentDate);
  if(!d.meals[mealId]) return;
  d.meals[mealId].splice(idx,1);
  saveData();
  renderDay();
}

function addEntriesToMeal(mealId,items){
  const d=getDayLog(currentDate);
  if(!d.meals[mealId]) d.meals[mealId]=[];
  d.meals[mealId].push(...items);
  saveData();
  closeModal();
  renderDay();
}

function updateGoal(key,val,unit){
  goals[key]=parseInt(val);
  const el=document.getElementById("gv-"+key);
  if(el) el.textContent=goals[key]+unit;
}

function resetGoal(key,val,unit){
  goals[key]=val;
  saveData();
  renderGoals();
}

// ── MODALS ────────────────────────────────────────────────────────────────────
function openModal(html){
  const root=document.getElementById("modal-root");
  root.innerHTML=`<div class="modal-overlay" onclick="handleOverlayClick(event)">${html}</div>`;
}

function handleOverlayClick(e){
  if(e.target.classList.contains("modal-overlay")) closeModal();
}

function closeModal(){
  document.getElementById("modal-root").innerHTML="";
  if(barcodeRunning) stopBarcode();
}

// SEARCH MODAL
function openSearch(mealId){
  openModal(`<div class="modal">
    <div class="modal-header">
      <div class="modal-title">Search Food</div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body">
      <input class="search-input" id="search-q" placeholder="Type to search... e.g. chicken, salmon" oninput="doSearch(this.value,'${mealId}')" autofocus>
      <div id="search-results"></div>
    </div>
  </div>`);
  setTimeout(()=>document.getElementById("search-q")?.focus(),100);
}

function doSearch(q,mealId){
  const res=document.getElementById("search-results");
  if(!res) return;
  if(q.length<2){res.innerHTML="";return;}
  const ql=q.toLowerCase();
  const matches=FOOD_DB.filter(f=>f.name.toLowerCase().includes(ql)).slice(0,10);
  if(!matches.length){res.innerHTML=`<div style="color:var(--muted);text-align:center;padding:20px;font-size:14px">No results — try Manual Entry</div>`;return;}
  res.innerHTML=matches.map((f,i)=>`
    <div class="search-result" onclick="openFoodDetail(${i},'${mealId}',false)" data-idx="${i}">
      <div>
        <div class="result-name">${f.name}${f.gluten?`<span class="gluten-badge">GLUTEN</span>`:""}</div>
        <div class="result-cat">${f.cat} · per ${f.per}${f.unit}</div>
      </div>
      <div class="result-macros">
        <div style="color:var(--protein);font-weight:700">${f.p}g P</div>
        <div>${f.cal} kcal</div>
      </div>
    </div>`).join("");
  window._searchMatches=matches;
  window._searchMealId=mealId;
}

function openFoodDetail(idx,mealId,fromBarcode,foodObj){
  const food=foodObj||(window._searchMatches&&window._searchMatches[idx]);
  if(!food) return;
  const glutenWarn=isGluten(food)?`<div class="gluten-warning">
    <div class="gluten-warning-icon">⚠️</div>
    <div class="gluten-warning-text">GLUTEN DETECTED — ${food.name} contains or may contain gluten. Your choice to consume.</div>
  </div>`:"";
  openModal(`<div class="modal">
    <div class="modal-header">
      <div class="modal-title">${food.name}</div>
      <button class="modal-close" onclick="${fromBarcode?"openBarcode('"+mealId+"')":"openSearch('"+mealId+"')"}">← Back</button>
    </div>
    <div class="modal-body">
      ${glutenWarn}
      <div style="color:var(--muted);font-size:13px;margin-bottom:8px">Amount (${food.unit})</div>
      <div class="qty-row">
        <input class="qty-input" id="qty-in" type="number" value="${food.per}" oninput="updatePreview()" min="0">
        <div class="qty-unit">${food.unit}</div>
      </div>
      <div class="preview-macros" id="preview-macros">
        <div class="preview-item"><div class="preview-val" style="color:var(--cal)" id="pv-cal">${food.cal}</div><div class="preview-lbl">kcal</div></div>
        <div class="preview-item"><div class="preview-val" style="color:var(--protein)" id="pv-p">${food.p}g</div><div class="preview-lbl">Protein</div></div>
        <div class="preview-item"><div class="preview-val" style="color:var(--carbs)" id="pv-c">${food.c}g</div><div class="preview-lbl">Carbs</div></div>
        <div class="preview-item"><div class="preview-val" style="color:var(--orange)" id="pv-f">${food.f}g</div><div class="preview-lbl">Fat</div></div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="confirm-btn" onclick="addFoodEntry('${mealId}')">Add to Log</button>
    </div>
  </div>`);
  window._currentFood=food;
  window._currentMealId=mealId;
}

function updatePreview(){
  const food=window._currentFood;
  if(!food) return;
  const qty=parseFloat(document.getElementById("qty-in")?.value)||0;
  const ratio=qty/(food.per||1);
  document.getElementById("pv-cal").textContent=fmt(food.cal*ratio);
  document.getElementById("pv-p").textContent=fmt(food.p*ratio)+"g";
  document.getElementById("pv-c").textContent=fmt(food.c*ratio)+"g";
  document.getElementById("pv-f").textContent=fmt(food.f*ratio)+"g";
}

function addFoodEntry(mealId){
  const food=window._currentFood;
  const qty=parseFloat(document.getElementById("qty-in")?.value)||food.per;
  if(!food) return;
  addEntriesToMeal(mealId,[{
    name:food.name,calories:food.cal,protein:food.p,carbs:food.c,fat:food.f,
    qty,per:food.per,unit:food.unit
  }]);
}

// SAVED MEAL MODAL
function openSavedMeal(mealId){
  const meal=SAVED_MEALS.find(m=>m.id===mealId);
  if(!meal) return;
  window._savedItems=meal.items.map(i=>({...i,included:true}));
  renderSavedMealModal(mealId);
}

function renderSavedMealModal(mealId){
  const meal=SAVED_MEALS.find(m=>m.id===mealId);
  const items=window._savedItems;
  const included=items.filter(i=>i.included);
  const macros=getMacros(included);
  const rows=items.map((item,i)=>`
    <div class="saved-item-row" style="opacity:${item.included?1:0.4}">
      <div class="checkbox ${item.included?"checked":""}" onclick="toggleSavedItem(${i},'${mealId}')">
        ${item.included?`<span style="color:#fff;font-size:14px;font-weight:700">✓</span>`:""}
      </div>
      <div class="saved-item-name">${item.name}${isGluten(item)?`<span class="gluten-badge">GLUTEN</span>`:""}</div>
      <input class="saved-qty-input" type="number" value="${item.qty}" onchange="updateSavedQty(${i},this.value,'${mealId}')">
      <div class="saved-unit">${item.unit}</div>
    </div>`).join("");
  openModal(`<div class="modal">
    <div class="modal-header">
      <div class="modal-title">${meal.emoji} ${meal.name}</div>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body">
      <div style="color:var(--muted);font-size:13px;margin-bottom:12px">Toggle items, adjust quantities, then log.</div>
      ${rows}
      <div class="preview-macros" style="margin-top:16px">
        <div class="preview-item"><div class="preview-val" style="color:var(--cal)">${fmt(macros.calories)}</div><div class="preview-lbl">kcal</div></div>
        <div class="preview-item"><div class="preview-val" style="color:var(--protein)">${fmt(macros.protein)}g</div><div class="preview-lbl">Protein</div></div>
        <div class="preview-item"><div class="preview-val" style="color:var(--carbs)">${fmt(macros.carbs)}g</div><div class="preview-lbl">Carbs</div></div>
        <div class="preview-item"><div class="preview-val" style="color:var(--orange)">${fmt(macros.fat)}g</div><div class="preview-lbl">Fat</div></div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="confirm-btn" onclick="logSavedMeal('${mealId}')">Log This Meal</button>
    </div>
  </div>`);
}

function toggleSavedItem(idx,mealId){
  window._savedItems[idx].included=!window._savedItems[idx].included;
  renderSavedMealModal(mealId);
}

function updateSavedQty(idx,val,mealId){
  window._savedItems[idx].qty=parseFloat(val)||0;
  renderSavedMealModal(mealId);
}

function logSavedMeal(mealId){
  const items=window._savedItems.filter(i=>i.included);
  addEntriesToMeal(mealId,items);
}

