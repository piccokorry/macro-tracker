<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Macros">
<meta name="theme-color" content="#0d1117">
<title>Macro Tracker — Korry Picco</title>
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon.png">
<style>
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  :root{
    --navy:#0d1117;--surface:#141b2d;--card:#1a2236;--border:#252f45;
    --text:#e8edf5;--muted:#8892a4;--dim:#3a4560;
    --blue:#3b82f6;--green:#34d399;--yellow:#fbbf24;--orange:#f97316;--red:#ef4444;--teal:#2dd4bf;
    --protein:#3b82f6;--carbs:#34d399;--fat:#f97316;--cal:#fbbf24;
  }
  html,body{height:100%;background:var(--navy);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display',system-ui,sans-serif;font-size:16px;overflow:hidden}
  #app{height:100vh;display:flex;flex-direction:column;max-width:430px;margin:0 auto;position:relative}
  
  /* HEADER */
  .header{background:var(--surface);border-bottom:1px solid var(--border);padding:env(safe-area-inset-top,0) 0 0;flex-shrink:0}
  .header-inner{padding:12px 16px 10px;display:flex;justify-content:space-between;align-items:center}
  .header h1{font-size:17px;font-weight:700;letter-spacing:-.3px}
  .header-sub{font-size:11px;color:var(--muted);letter-spacing:.5px;text-transform:uppercase}
  .share-btn{background:var(--blue);color:#fff;border:none;border-radius:8px;padding:7px 14px;font-size:13px;font-weight:600;cursor:pointer}

  /* NAV TABS */
  .nav{display:flex;background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0}
  .nav-btn{flex:1;padding:10px 4px;background:none;border:none;color:var(--muted);font-size:11px;font-weight:600;letter-spacing:.4px;text-transform:uppercase;cursor:pointer;border-bottom:2px solid transparent;transition:all .2s}
  .nav-btn.active{color:var(--blue);border-bottom-color:var(--blue)}

  /* SCROLL AREA */
  .scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:16px 14px calc(env(safe-area-inset-bottom,0) + 16px)}
  
  /* DATE NAV */
  .date-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
  .date-nav button{background:var(--card);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:8px 14px;font-size:18px;cursor:pointer}
  .date-nav button:disabled{opacity:.3;cursor:not-allowed}
  .date-label{font-size:19px;font-weight:700}

  /* SUMMARY CARD */
  .summary{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:18px;margin-bottom:14px}
  .cal-row{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:16px}
  .cal-big{font-size:42px;font-weight:800;color:var(--cal);line-height:1}
  .cal-label{font-size:13px;color:var(--muted)}
  .macro-pills{display:flex;gap:12px}
  .macro-pill{text-align:center}
  .macro-pill .val{font-size:22px;font-weight:700;line-height:1}
  .macro-pill .lbl{font-size:11px;color:var(--muted);margin-top:2px}
  .macro-pill .rem{font-size:10px;margin-top:1px}
  .bar-row{margin-bottom:10px}
  .bar-label-row{display:flex;justify-content:space-between;margin-bottom:4px;font-size:12px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--muted)}
  .bar-track{height:8px;background:var(--card);border-radius:4px;overflow:hidden}
  .bar-fill{height:100%;border-radius:4px;transition:width .4s ease}

  /* WATER */
  .water-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:14px}
  .water-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .water-title{font-size:15px;font-weight:700;display:flex;align-items:center;gap:6px}
  .water-val{font-size:14px;font-weight:700;color:var(--teal)}
  .water-btns{display:flex;gap:8px;margin-top:10px}
  .water-btn{flex:1;padding:8px 4px;background:var(--card);border:1px solid var(--border);border-radius:8px;color:var(--muted);font-size:12px;font-weight:600;cursor:pointer}
  .water-btn-minus{padding:8px 12px;background:var(--card);border:1px solid var(--border);border-radius:8px;color:var(--red);font-size:14px;font-weight:700;cursor:pointer}

  /* MEAL CARDS */
  .meal-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;margin-bottom:10px;overflow:hidden}
  .meal-header{padding:14px 16px;display:flex;justify-content:space-between;align-items:center;cursor:pointer}
  .meal-left{display:flex;align-items:center;gap:10px}
  .meal-emoji{font-size:22px}
  .meal-name{font-size:15px;font-weight:700}
  .meal-time{font-size:12px;color:var(--muted);margin-top:1px}
  .meal-right{display:flex;align-items:center;gap:12px}
  .meal-macros{display:flex;gap:10px;font-size:12px}
  .meal-body{border-top:1px solid var(--border)}
  .entry-row{padding:10px 16px;border-bottom:1px solid #1a2236;display:flex;justify-content:space-between;align-items:center}
  .entry-name{font-size:14px;color:#c8d0e0}
  .entry-qty{font-size:12px;color:var(--muted);margin-top:2px}
  .entry-macros{display:flex;gap:8px;align-items:center;font-size:12px}
  .entry-actions{display:flex;gap:4px;margin-left:8px}
  .entry-btn{background:none;border:none;color:var(--muted);cursor:pointer;font-size:16px;padding:4px 6px;border-radius:6px}
  .meal-actions{display:flex;gap:8px;padding:12px 16px}
  .meal-action-btn{flex:1;padding:9px;background:var(--card);border:1px solid var(--border);border-radius:8px;color:var(--muted);font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px}

  /* MODAL OVERLAY */
  .modal-overlay{position:absolute;inset:0;background:rgba(0,0,0,.8);display:flex;flex-direction:column;justify-content:flex-end;z-index:100}
  .modal{background:var(--surface);border-radius:20px 20px 0 0;border:1px solid var(--border);border-bottom:none;max-height:90vh;display:flex;flex-direction:column;padding-bottom:env(safe-area-inset-bottom,0)}
  .modal-header{padding:16px 20px 12px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);flex-shrink:0}
  .modal-title{font-size:18px;font-weight:700}
  .modal-close{background:var(--card);border:none;color:var(--muted);border-radius:50%;width:30px;height:30px;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center}
  .modal-body{flex:1;overflow-y:auto;padding:16px 20px}
  .modal-footer{padding:12px 20px;border-top:1px solid var(--border);flex-shrink:0}

  /* SEARCH */
  .search-input{width:100%;padding:13px 16px;background:var(--card);border:1px solid var(--border);border-radius:12px;color:var(--text);font-size:16px;outline:none;margin-bottom:12px}
  .search-result{padding:12px;border-bottom:1px solid var(--card);display:flex;justify-content:space-between;align-items:center;cursor:pointer;border-radius:8px;margin-bottom:4px;background:var(--card)}
  .result-name{font-size:14px;font-weight:600;color:var(--text)}
  .result-cat{font-size:11px;color:var(--muted);margin-top:2px}
  .result-macros{text-align:right;font-size:12px;color:var(--muted)}
  .gluten-badge{display:inline-block;background:#7f1d1d;color:#fca5a5;font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;margin-left:6px;letter-spacing:.3px}

  /* QTY PICKER */
  .qty-row{display:flex;align-items:center;gap:12px;margin-bottom:16px}
  .qty-input{flex:1;padding:13px;background:var(--card);border:1px solid var(--border);border-radius:12px;color:var(--text);font-size:20px;font-weight:700;text-align:center;outline:none}
  .qty-unit{color:var(--muted);font-size:14px;min-width:40px}
  .preview-macros{display:flex;justify-content:space-around;padding:14px;background:var(--card);border-radius:12px;margin-bottom:16px}
  .preview-item{text-align:center}
  .preview-val{font-size:20px;font-weight:700}
  .preview-lbl{font-size:11px;color:var(--muted);margin-top:2px}

  /* CONFIRM BTN */
  .confirm-btn{width:100%;padding:15px;background:var(--blue);color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer;transition:opacity .2s}
  .confirm-btn:disabled{opacity:.4;cursor:not-allowed}
  .confirm-btn.danger{background:var(--red)}

  /* CAMERA / BARCODE */
  .camera-area{border-radius:12px;overflow:hidden;margin-bottom:16px;background:#000;position:relative;min-height:220px;display:flex;align-items:center;justify-content:center}
  #barcode-video{width:100%;height:220px;object-fit:cover;display:block}
  .scan-line{position:absolute;width:80%;height:2px;background:var(--blue);left:10%;animation:scan 2s linear infinite}
  @keyframes scan{0%{top:20%}50%{top:80%}100%{top:20%}}
  .scan-corners{position:absolute;inset:0;pointer-events:none}
  .corner{position:absolute;width:24px;height:24px;border-color:var(--blue);border-style:solid}
  .corner.tl{top:16px;left:16px;border-width:3px 0 0 3px}
  .corner.tr{top:16px;right:16px;border-width:3px 3px 0 0}
  .corner.bl{bottom:16px;left:16px;border-width:0 0 3px 3px}
  .corner.br{bottom:16px;right:16px;border-width:0 3px 3px 0}
  .scan-status{position:absolute;bottom:12px;left:0;right:0;text-align:center;font-size:13px;color:#fff;font-weight:600;background:rgba(0,0,0,.5);padding:4px 0}

  /* SAVED MEAL MODAL */
  .saved-item-row{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--card)}
  .checkbox{width:22px;height:22px;border-radius:6px;border:2px solid var(--border);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .2s}
  .checkbox.checked{background:var(--blue);border-color:var(--blue)}
  .saved-item-name{flex:1;font-size:14px;color:#c8d0e0}
  .saved-qty-input{width:70px;padding:7px 8px;background:var(--navy);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:14px;text-align:center;outline:none}
  .saved-unit{font-size:12px;color:var(--muted);min-width:30px}

  /* WEEK VIEW */
  .week-bars{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:20px}
  .week-day{text-align:center}
  .week-label{font-size:11px;color:var(--muted);margin-bottom:6px;font-weight:600}
  .week-label.today{color:var(--blue)}
  .week-bar-track{height:60px;background:var(--card);border-radius:6px;display:flex;align-items:flex-end;overflow:hidden}
  .week-bar-fill{width:100%;border-radius:4px;transition:height .3s ease;min-height:0}
  .week-cal{font-size:10px;color:var(--muted);margin-top:4px}
  .avg-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .avg-card{background:var(--card);border-radius:12px;padding:14px;text-align:center}
  .avg-val{font-size:24px;font-weight:700;margin-bottom:4px}
  .avg-lbl{font-size:12px;color:var(--muted)}

  /* GOALS VIEW */
  .goals-item{background:var(--card);border-radius:12px;padding:16px;margin-bottom:12px}
  .goals-label-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
  .goals-label{font-size:15px;font-weight:600}
  .goals-val{font-size:16px;font-weight:700;color:var(--blue)}
  .goals-range{width:100%;margin-bottom:8px;accent-color:var(--blue)}
  .goals-minmax{display:flex;justify-content:space-between;font-size:11px;color:var(--dim)}
  .reset-defaults{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
  .default-btn{padding:7px 13px;background:var(--card);border:1px solid var(--border);border-radius:8px;color:var(--muted);font-size:12px;font-weight:600;cursor:pointer}

  /* SHARE MODAL */
  .share-text{background:var(--navy);border:1px solid var(--border);border-radius:10px;padding:14px;font-size:13px;color:var(--text);font-family:monospace;line-height:1.6;white-space:pre-wrap;margin-bottom:16px;max-height:300px;overflow-y:auto}
  .copy-btn{width:100%;padding:14px;background:var(--green);color:var(--navy);border:none;border-radius:12px;font-size:16px;font-weight:700;cursor:pointer}

  /* MANUAL ENTRY */
  .manual-field{margin-bottom:14px}
  .manual-label{font-size:13px;color:var(--muted);margin-bottom:6px;font-weight:600;letter-spacing:.3px;text-transform:uppercase}
  .manual-input{width:100%;padding:12px 14px;background:var(--card);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:16px;outline:none}
  .meal-select{width:100%;padding:12px 14px;background:var(--card);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:16px;outline:none;appearance:none}

  /* GLUTEN WARNING */
  .gluten-warning{background:#450a0a;border:1px solid #7f1d1d;border-radius:10px;padding:12px 14px;margin-bottom:14px;display:flex;align-items:center;gap:10px}
  .gluten-warning-icon{font-size:22px;flex-shrink:0}
  .gluten-warning-text{font-size:13px;color:#fca5a5;font-weight:600}

  /* SPINNER */
  .spinner{width:24px;height:24px;border:3px solid var(--border);border-top-color:var(--blue);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto}
  @keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
